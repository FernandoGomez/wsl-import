<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wsl-import</AssemblyName>
    <RootNamespace>WslImport</RootNamespace>
  </PropertyGroup>

  <!-- Exclude the installer sub-project so its obj/*.cs files don't pollute this build -->
  <ItemGroup>
    <Compile Remove="installer\**" />
    <EmbeddedResource Remove="installer\**" />
    <None Remove="installer\**" />
  </ItemGroup>
</Project>
